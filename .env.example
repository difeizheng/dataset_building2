# 三峡集团数据集建设平台 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# 达梦 DM8 数据库用户名（建议不要使用默认的 SYSDBA）
DB_USERNAME=SYSDBA
DM8_SYSDBA_PASSWORD=

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== 安全配置 ====================
# JWT 签名密钥（生产环境必须使用强随机密钥，至少32字符）
# 生成方式：openssl rand -base64 32
JWT_SECRET=

# ==================== AI 中台配置 ====================
AI_PLATFORM_API_KEY=

# ==================== 外部服务配置 ====================
# AI 中台地址
AI_PLATFORM_BASE_URL=http://ai-platform.ctg.com

# ==================== 镜像版本 ====================
# 达梦数据库镜像版本
DM8_VERSION=latest
